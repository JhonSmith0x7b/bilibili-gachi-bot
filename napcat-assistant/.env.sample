NAPCAT_API_BASE_URL=http://napcat:3000
NAPCAT_API_TOKEN=
NAPCAT_WS_URL=ws://napcat:3001
# 留空则使用 NAPCAT_API_TOKEN；需与 NapCat WebSocket 服务端 Token 一致。
NAPCAT_WS_TOKEN=
# 图片命名如 20261013-20261020.png，按北京时间日期自动选择。
WEEKLY_IMAGE_DIR=/data
# 同一群同一指令的冷却时间，设为 0 可关闭。
COMMAND_COOLDOWN_SECONDS=5
NAPCAT_DOCKER_NETWORK=napcat_default
